# Laravel API used at build time to render content (see backend/). Leave empty to build from bundled content.
PMO_API_URL=http://127.0.0.1:8000/api/v1
# Public API base used by the browser for the enquiry form.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
# Cloudflare Turnstile site key for the enquiry-form captcha (must pair with the
# backend's TURNSTILE_SECRET_KEY). This is Cloudflare's always-pass test key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
